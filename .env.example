# Template for `.env` — copy it and fill in the blanks on each host:
#
#     cp .env.example .env
#
# `.env` itself is gitignored: it carries DATABASE_URL, JWT_SECRET and the
# ext-api app password. Keys left blank below have no safe default and
# the service will not work until they are set; keys with values are defaults
# that suit the documented deployment (docs/DEPLOYMENT.md).
#
# JWT_SECRET and the EXT_APP_* pair are SHARED with duerp-api and must match it
# exactly — a drift there shows up as confusing intermittent 401s.

# Optional. Absolute path to the env file to load, skipping dotenvy's search
# upward from the working directory. Set it when the service is started from
# somewhere other than the crate root and the unit has no EnvironmentFile= —
# otherwise nothing is loaded and startup dies on "DATABASE_URL is not set".
# ENV_FILE=/var/www/face_recognition/duerp-face-recognition-backend/.env

DATABASE_URL=
JWT_SECRET=
RUST_LOG=debug
SSL_API_ENDPOINT=
# Base URL of the login upstream for `POST /login`, when it is NOT the same
# host as SSL_API_ENDPOINT. Set it to DU's ITS gateway (`https://api.its.du.ac.bd/`)
# and leave SSL_API_ENDPOINT on DU's Laravel backend: only the latter serves
# `getByEmployeeId`, which enroll/verify need (the gateway 404s it).
#
# The two speak DIFFERENT dialects and `src/routes/auth.rs` picks by variable,
# not by sniffing: gateway = JSON `{username, password}` answering `user_data`,
# Laravel = form field `email` plus `secret-key` answering `user`. Leave this
# blank and login falls back to SSL_API_ENDPOINT with the Laravel shape, which
# is the historical behaviour. Must end in `/` — a missing slash is appended.
LOGIN_API_ENDPOINT=
EXT_APP_ID=
EXT_APP_PASSWORD=

# WOW Attendance — AI face platform
WOW_AI_BASE_URL=
WOW_AI_API_KEY=
# ABSOLUTE path on purpose: the default (./uploads/wow_attendance) is relative
# to the process working directory, which under systemd/docker is not the repo
# root. Must be writable by the service user.
#
# This service OWNS its uploads folder — it lives under duerp-attendance, not
# inside duerp-api's. Face captures are attendance's data, and nothing in
# duerp-api reads them. Consequence to keep in mind: `/uploads/wow_attendance/*`
# is now served by THIS process (:8081), not by duerp-api (:8080), so the
# reverse proxy needs a rule for that prefix — see docs/DEPLOYMENT.md.
WOW_UPLOAD_DIR=/var/www/face_recognition/duerp-face-recognition-backend/uploads/wow_attendance
# Directory the `/uploads` URL is served from — the PARENT of WOW_UPLOAD_DIR,
# since the `/uploads` prefix supplies the `wow_attendance/...` remainder. Keep
# these two pointing at the same `uploads` folder.
WOW_UPLOADS_SERVE_DIR=/var/www/face_recognition/duerp-face-recognition-backend/uploads
# Card photos and selfies from POST /ext-api/nfc-card/save_card_info. A SIBLING
# of WOW_UPLOAD_DIR, not a child: a card photo is not a face capture, and the
# enrollment flow treats its own folder as exclusively its. Still inside
# WOW_UPLOADS_SERVE_DIR, so a saved file resolves to a `/uploads/...` URL — the
# save response returns those URLs, and they 404 if this moves outside.
# The service creates `cards/` and `selfies/` beneath it on first upload.
# Optional; defaults to ./uploads/nfc_card relative to the working directory.
NFC_UPLOAD_DIR=/var/www/face_recognition/duerp-face-recognition-backend/uploads/nfc_card
# Per-call step logs. Placed UNDER the uploads folder on purpose: that folder is
# bind-mounted on the server, so the logs show up on the host over the same mount
# as the images (no separate docs volume needed). ABSOLUTE path so it does not
# depend on the process working directory. Must be writable by the service user.
#
# SECURITY: this sits inside the folder the `/uploads` route serves, so main.rs
# registers a block on `/uploads/log` BEFORE that route — the logs carry tokens,
# client IPs and employee ids and must never be reachable over HTTP. If you move
# this path OUT of <uploads>, the block no longer covers it: re-check exposure.
# This service's OWN step logs, under its own uploads folder — same ownership
# rule as the face images. The admin viewer in duerp-api reads BOTH folders now
# (it is told about this one via WOW_ATTENDANCE_LOG_DIR in duerp-api/.env), so
# nothing disappears from that screen by living here.
#
# SECURITY: this sits inside the folder THIS service serves at /uploads, so
# main.rs's 404 block on /uploads/log is load-bearing here — the logs carry
# client IPs, employee ids, GPS and face-photo paths. Moving this path out of
# <uploads> means the block no longer covers it: re-check exposure.
WOW_LOG_DIR=/var/www/face_recognition/duerp-face-recognition-backend/uploads/log

# Per-login step logs, one file per sign-in attempt at POST /login. Kept in
# their OWN folder rather than WOW_LOG_DIR: logins are high-volume and would
# bury the attendance calls that folder exists to explain.
#
# SECURITY: same rule as WOW_LOG_DIR — this sits inside the folder THIS service
# serves at /uploads, so main.rs's 404 block on /uploads/login is load-bearing.
# These files carry usernames, client IPs, employee ids and the DU user object.
# Moving this path out of <uploads> means the block no longer covers it.
LOGIN_LOG_DIR=/var/www/face_recognition/duerp-face-recognition-backend/uploads/login

WOW_AI_MODEL_NAME=ArcFace
WOW_AI_THRESHOLD=0.55
# Max accepted size for a single uploaded image, in megabytes (default 5).
WOW_MAX_IMAGE_MB=5
# TEMPORARY: id_type fallback, used when DU's getByEmployeeId does NOT confirm
# the token holder is an employee — i.e. every student, because DU has no
# student-by-id endpoint yet. Remove once that endpoint exists and students
# resolve to `Student` on their own.
# (Per-request override: send the `X-Id-Type` header instead.)
WOW_IDTYPE_FALLBACK=Employee
# TEMPORARY (migration window): also accept DU's own Laravel access_token on
# enroll/verify, alongside the token this service issues from POST /login.
# A DU token's signature CANNOT be verified here (DU holds the secret), so a
# forged one passes — only ExtAuthMiddleware stands behind it. Its `sub` is the
# DU user_id, which getByEmployeeId rejects (422), so such a caller is never
# confirmed against DU and always lands on WOW_IDTYPE_FALLBACK above.
# Set to `false` once every client sends the POST /login token; the step logs
# flag each request still arriving on a legacy DU token ("LEGACY DU token").
WOW_ACCEPT_DU_TOKEN=true
# Bind address and port. 8083 is also the code default (src/main.rs), but it is
# pinned here too so the value is visible where the rest of the config lives.
#
# NOT 8081: another project on this box, student_scholarship_api
# (/var/www/existing_project/du_scholarship_rust/backend), binds 8081 and starts
# independently of this one. Two services racing for a port fail whichever loses
# with `Os { code: 98, AddrInUse }` — which is what happened on 2026-09-01.
# If you move this, update the two nginx proxy_pass blocks in docs/DEPLOYMENT.md
# (/ext-api/wow-attendance/ and /uploads/wow_attendance/) to match.
ATTENDANCE_BIND=0.0.0.0
ATTENDANCE_PORT=8083

# Public origin used to turn a saved image's path into an openable URL in the
# step logs (the `Images:` section and each `File:` step line).
#
# Leave it UNSET when this service is reached directly — the request's own
# scheme+host is then used, which is correct. Set it when a reverse proxy sits
# in front: the request Host is the internal `127.0.0.1:8083`, which no admin
# reading the log can open. `connection_info()` does honour X-Forwarded-Proto /
# X-Forwarded-Host, so a proxy that sets those needs nothing here either.
#
# If neither is available the log keeps the relative `/uploads/...` path rather
# than inventing an origin — a wrong host looks clickable and 404s elsewhere.
# WOW_PUBLIC_BASE_URL=https://erp.du.ac.bd
