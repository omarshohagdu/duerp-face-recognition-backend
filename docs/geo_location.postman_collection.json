                "key": "X-App-Id",
                "value": "{{app_id}}"
              },
              {
                "key": "X-App-Password",
                "value": "{{app_password}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ext-api/geo-location/requests?status=PENDING&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ext-api",
                "geo-location",
                "requests"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "office_id",
                  "value": "{{office_id}}",
                  "disabled": true,
                  "description": "body code"
                },
                {
                  "key": "employee_id",
                  "value": "{{employee_id}}",
                  "disabled": true,
                  "description": "exact; use with status=ALL for one employee's offices"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true,
                  "description": "emp-id prefix or name"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Paginated, oldest request first. status: PENDING (default) | APPROVED | REJECTED | REVOKED | REMOVED | ALL. search = employee-id prefix or name substring. limit ≤ 100. The first item's id is saved to `{{selection_id}}`."
