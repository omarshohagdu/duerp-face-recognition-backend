    {
      "name": "3. Admin · Approvals",
      "description": "Permission `attendance.geo.review` (admin / superadmin). Use `admin_token`.",
      "item": [
        {
          "name": "3.1 List requests (pending queue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
