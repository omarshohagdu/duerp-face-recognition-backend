                  "if (j.status === 'success' && j.data.items && j.data.items.length) { pm.collectionVariables.set('selection_id', j.data.items[0].id); console.log('saved selection_id=' + j.data.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
